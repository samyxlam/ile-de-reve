; Engine configuration file.
; Prototype "Île de Rêve" — remake librement inspiré de 去有梦的小岛 (WeChat mini-game).
; Godot 4.7+

config_version=5

[application]

config/name="Île de Rêve — Prototype"
config/description="Prototype de merge-2 : plateau de fusion, générateurs, commandes, île à bâtir, fouille d'objets cachés, pass d'événement et classement. Interface EN/FR/ZH."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Data="*res://scripts/data.gd"
State="*res://scripts/state.gd"
Son="*res://scripts/son.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=432
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
